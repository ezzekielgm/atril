{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atril",
  "mainBinaryName": "Atril",
  "version": "1.0.0",
  "identifier": "io.github.ezzekielgm.atril",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Atril",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Atril",
    "category": "Productivity",
    "shortDescription": "Leer, ensayar, presentar y editar discursos",
    "longDescription": "Atril abre tus discursos de Word con letra grande, te ayuda a ensayarlos con cronómetro y a presentarlos, y los guarda otra vez en el mismo Word.",
    "copyright": "Ezequiel",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "wix": {
        "language": "es-ES",
        "fragmentPaths": ["windows/abrir-con.wxs"],
        "componentRefs": ["AbrirConAtril"]
      },
      "nsis": {
        "languages": ["Spanish"],
        "installMode": "currentUser",
        "installerHooks": "windows/abrir-con.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
